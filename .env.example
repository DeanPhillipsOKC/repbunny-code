# Nothing here is needed to run, build, or test the app: it has no backend and no
# keys (#940). These are optional settings for scripts on the laptop. Copy to
# .env.local; never commit real values.

# Used by scripts/Send-Notification.ps1 to email
# a description of each shipped/blocked backlog item from any next-item run (interactive,
# or headless). Unset means notifications are silently skipped. See
# docs/backlog-runner.md for setup (Gmail App Password, not your normal Gmail password).
GMAIL_SENDER_ADDRESS=
GMAIL_APP_PASSWORD=
NOTIFY_EMAIL_RECIPIENTS=
