<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Issue #76: allowBackup stays on, so Google's Auto Backup takes the
         app, including the SQLite database (databases/repbunnySQLite.db).
         Issue #430: the backup rules leave out only the restore points
         database (res/xml/backup_rules.xml, data_extraction_rules.xml); any
         change to them must keep the main database in. -->
    <application
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
        </activity>

        <!-- Issue #145: the app icon. Each theme's icon is a launcher alias
             of MainActivity named Icon<ThemeId in PascalCase>; exactly one is
             enabled (Classic by default) and AppIconPlugin.java switches
             between them. A new theme's icon gets an alias here after
             scripts/generate-theme-icons.mjs has made its ic_launcher_<id>.
             The seasonal icons (#841) work the same way. Issue #861:
             .IconClassic is the build's default icon, the picker's Default
             (seasonal in a store build cut with one, #857), and .IconRose is
             the rose Classic icon all year. -->
        <activity-alias
            android:name=".IconClassic"
            android:targetActivity=".MainActivity"
            android:label="@string/title_activity_main"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconRose"
            android:targetActivity=".MainActivity"
            android:label="@string/title_activity_main"
            android:icon="@mipmap/ic_launcher_rose"
            android:roundIcon="@mipmap/ic_launcher_rose_round"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <!-- Issue #861: the Halloween and Autumn themes' own icons are gone,
             and a phone still on one is moved to the seasonal icon at launch
             (src/lib/appIcon.ts). These two aliases stay, showing the
             seasonal art, because removing an enabled alias would leave the
             app with no launcher entry on a phone that skipped the move. -->
        <activity-alias
            android:name=".IconHalloween"
            android:targetActivity=".MainActivity"
            android:label="@string/title_activity_main"
            android:icon="@mipmap/ic_launcher_season_halloween"
            android:roundIcon="@mipmap/ic_launcher_season_halloween_round"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconAutumn"
            android:targetActivity=".MainActivity"
            android:label="@string/title_activity_main"
            android:icon="@mipmap/ic_launcher_season_autumn"
            android:roundIcon="@mipmap/ic_launcher_season_autumn_round"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconCottonCandy"
            android:targetActivity=".MainActivity"
            android:label="@string/title_activity_main"
            android:icon="@mipmap/ic_launcher_cotton_candy"
            android:roundIcon="@mipmap/ic_launcher_cotton_candy_round"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconChalk"
            android:targetActivity=".MainActivity"
            android:label="@string/title_activity_main"
            android:icon="@mipmap/ic_launcher_chalk"
            android:roundIcon="@mipmap/ic_launcher_chalk_round"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconCarrotPatch"
            android:targetActivity=".MainActivity"
            android:label="@string/title_activity_main"
            android:icon="@mipmap/ic_launcher_carrot_patch"
            android:roundIcon="@mipmap/ic_launcher_carrot_patch_round"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconSunrise"
            android:targetActivity=".MainActivity"
            android:label="@string/title_activity_main"
            android:icon="@mipmap/ic_launcher_sunrise"
            android:roundIcon="@mipmap/ic_launcher_sunrise_round"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <!-- Issue #841: the seasonal icons, from
             scripts/generate-seasonal-icons.mjs. -->
        <activity-alias
            android:name=".IconSeasonAutumn"
            android:targetActivity=".MainActivity"
            android:label="@string/title_activity_main"
            android:icon="@mipmap/ic_launcher_season_autumn"
            android:roundIcon="@mipmap/ic_launcher_season_autumn_round"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconSeasonHalloween"
            android:targetActivity=".MainActivity"
            android:label="@string/title_activity_main"
            android:icon="@mipmap/ic_launcher_season_halloween"
            android:roundIcon="@mipmap/ic_launcher_season_halloween_round"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconSeasonSnowGlobe"
            android:targetActivity=".MainActivity"
            android:label="@string/title_activity_main"
            android:icon="@mipmap/ic_launcher_season_snow_globe"
            android:roundIcon="@mipmap/ic_launcher_season_snow_globe_round"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconSeasonChristmas"
            android:targetActivity=".MainActivity"
            android:label="@string/title_activity_main"
            android:icon="@mipmap/ic_launcher_season_christmas"
            android:roundIcon="@mipmap/ic_launcher_season_christmas_round"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Issue #143: the lock-screen rest timer's +15s / Skip buttons and
             its end-of-rest alarm (RestLive.java). -->
        <receiver
            android:name=".RestActionReceiver"
            android:exported="false" />

        <!-- Issue #144: home screen widgets (Premium), drawn by
             HomeWidgets.java from the snapshot the app writes. -->
        <receiver
            android:name=".WeekWidgetProvider"
            android:label="@string/widget_week_label"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_week_info" />
        </receiver>
        <receiver
            android:name=".NextWorkoutWidgetProvider"
            android:label="@string/widget_next_label"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_next_info" />
        </receiver>
        <receiver
            android:name=".RecordWidgetProvider"
            android:label="@string/widget_record_label"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_record_info" />
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
</manifest>
