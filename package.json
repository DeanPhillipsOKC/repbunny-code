{
  "name": "workout-tracker-pwa",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b --noEmit",
    "check:library": "node scripts/check-exercise-library.mjs",
    "check:docs": "node scripts/check-docs-refs.mjs",
    "check:size": "node scripts/check-file-size.mjs",
    "check:public": "node scripts/check-public.mjs",
    "test:e2e": "playwright test",
    "android:sync": "npm run build && cap sync android",
    "ios:sync": "npm run build && cap sync ios",
    "qa:fixtures": "node scripts/qa/generate-fixtures.mjs",
    "qa:page": "node scripts/qa/build-page.mjs",
    "backup:repo": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Backup-Repo.ps1",
    "prepare": "git config core.hooksPath scripts/git-hooks || exit 0"
  },
  "dependencies": {
    "@capacitor-community/in-app-review": "^8.0.0",
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.3",
    "@capgo/native-purchases": "^8.9.6",
    "capacitor-email-composer": "^8.0.0",
    "jeep-sqlite": "^2.8.0",
    "jspdf": "^4.2.1",
    "minisearch": "^7.2.0",
    "pinia": "^4.1.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@playwright/test": "1.64.1",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-vue": "^6.0.10",
    "actions-minutes-estimator": "0.1.0",
    "sql.js": "^1.15.2",
    "sql.js-jeep": "npm:sql.js@1.11.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vue-tsc": "^3.3.13"
  }
}
